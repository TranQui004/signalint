{
  "name": "signalint-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.TranQui004/signalint",
  "description": "Agent-optimized code feedback MCP server for JavaScript and TypeScript projects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TranQui004/signalint.git"
  },
  "homepage": "https://github.com/TranQui004/signalint#readme",
  "bugs": {
    "url": "https://github.com/TranQui004/signalint/issues"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "antigravity",
    "biome",
    "claude",
    "code-review",
    "codex",
    "coding-agent",
    "context-window",
    "cursor",
    "developer-tools",
    "diagnostics",
    "eslint",
    "lint",
    "linter",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "oxlint",
    "static-analysis",
    "type-checking",
    "typescript",
    "vscode",
    "windsurf",
    "zed"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "signalint-mcp": "./dist/src/index.js",
    "signalint": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "glama.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src test --ignore-pattern test/fixtures",
    "start": "node dist/src/index.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@biomejs/biome": "2.5.15",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "^8.20.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
